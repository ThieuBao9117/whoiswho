<?xml version="1.0" encoding="UTF-8"?>
<!--
    web.config cho HRM site tren IIS
    Them vao thu muc goc cua HRM (vi du: D:\WHO\ hoac C:\inetpub\wwwroot\hrm\)
    
    TAC DUNG:
    - /game/assets/* : IIS serve file tinh tu C:\inetpub\wwwroot\game\
    - /game/api/*    : Proxy sang CSB Backend (localhost:7000)
    - /game/*        : Tra ve index.html (React SPA)
    - /*             : Forward sang Django (giu nguyen hien tai)
    
    YEU CAU: IIS URL Rewrite + ARR da duoc cai san (da xac nhan co ARR/3.0)
-->
<configuration>
  <system.webServer>

    <rewrite>
      <rules>

        <!-- ======================================================= -->
        <!-- QUAN TRONG: Cac rule /game/* phai dat TRUOC rule Django  -->
        <!-- ======================================================= -->

        <!-- Rule 0: Logo redirect - /logo.png -> /game/logo.png -->
        <rule name="CSB Logo Redirect" stopProcessing="true">
          <match url="^logo\.png$" />
          <action type="Rewrite" url="/game/logo.png" />
        </rule>

        <!-- Rule 1: Files tinh cua CSB (JS, CSS, images) - phuc vu truc tiep -->
        <rule name="CSB Static Assets" stopProcessing="true">
          <match url="^game/assets/(.*)" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
          </conditions>
          <action type="None" />
        </rule>

        <!-- Rule 2: CSB API - Reverse Proxy sang FastAPI port 7000 -->
        <rule name="CSB API Reverse Proxy" stopProcessing="true">
          <match url="^game/api/(.*)" />
          <action type="Rewrite"
                  url="http://localhost:7000/api/{R:1}"
                  appendQueryString="true" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_HOST" value="50.50.50.4" />
            <set name="HTTP_X_FORWARDED_PROTO" value="http" />
          </serverVariables>
        </rule>

        <!-- Rule 3: CSB Root API (health check, swagger) -->
        <rule name="CSB Root Proxy" stopProcessing="true">
          <match url="^game/docs(.*)" />
          <action type="Rewrite"
                  url="http://localhost:7000/docs{R:1}"
                  appendQueryString="true" />
        </rule>

        <!-- Rule 4: SPA fallback - /game/* -> index.html (React Router) -->
        <!--  Ap dung khi URL khong phai la file thuc te tren disk         -->
        <rule name="CSB Game SPA Fallback" stopProcessing="true">
          <match url="^game(/.*)?$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/game/index.html" />
        </rule>

        <!-- ======================================================= -->
        <!-- Rule Django: giu nguyen (neu da co, khong chinh sua)    -->
        <!-- Neu chua co rule Django, can them o day hoac giu web.config hien tai -->
        <!-- ======================================================= -->

      </rules>
    </rewrite>

    <!-- Cho phep ARR proxy headers -->
    <proxy enabled="true" preserveHostHeader="true" />

  </system.webServer>
</configuration>
